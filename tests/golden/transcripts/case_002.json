[
 {
  "id": 19608,
  "sequence_no": 0,
  "start_ms": 0,
  "end_ms": 2960,
  "text": "民办大学正在被00后集体退货"
 },
 {
  "id": 19609,
  "sequence_no": 1,
  "start_ms": 2960,
  "end_ms": 4480,
  "text": "已经快彻底招不到人了"
 },
 {
  "id": 19610,
  "sequence_no": 2,
  "start_ms": 4480,
  "end_ms": 5640,
  "text": "2026年高考"
 },
 {
  "id": 19611,
  "sequence_no": 3,
  "start_ms": 5640,
  "end_ms": 7640,
  "text": "1290万考生挤破头"
 },
 {
  "id": 19612,
  "sequence_no": 4,
  "start_ms": 7640,
  "end_ms": 9800,
  "text": "按理说学校该挑花眼了吧"
 },
 {
  "id": 19613,
  "sequence_no": 5,
  "start_ms": 9800,
  "end_ms": 10360,
  "text": "结果呢"
 },
 {
  "id": 19614,
  "sequence_no": 6,
  "start_ms": 10360,
  "end_ms": 12600,
  "text": "民办大学跪在地上求学生来"
 },
 {
  "id": 19615,
  "sequence_no": 7,
  "start_ms": 12600,
  "end_ms": 14080,
  "text": "学生头都不带回一下了"
 },
 {
  "id": 19616,
  "sequence_no": 8,
  "start_ms": 14080,
  "end_ms": 17720,
  "text": "广东湛江科技学院计划招7544人"
 },
 {
  "id": 19617,
  "sequence_no": 9,
  "start_ms": 17720,
  "end_ms": 21080,
  "text": "首轮投档只进来1189份档案"
 },
 {
  "id": 19618,
  "sequence_no": 10,
  "start_ms": 21080,
  "end_ms": 22840,
  "text": "缺额率84%"
 },
 {
  "id": 19619,
  "sequence_no": 11,
  "start_ms": 22840,
  "end_ms": 24560,
  "text": "三轮征集志愿补录完"
 },
 {
  "id": 19620,
  "sequence_no": 12,
  "start_ms": 24560,
  "end_ms": 26560,
  "text": "还剩2148个坑"
 },
 {
  "id": 19621,
  "sequence_no": 13,
  "start_ms": 26560,
  "end_ms": 27240,
  "text": "没人填"
 },
 {
  "id": 19622,
  "sequence_no": 14,
  "start_ms": 27240,
  "end_ms": 28920,
  "text": "上海新卫学院更绝"
 },
 {
  "id": 19623,
  "sequence_no": 15,
  "start_ms": 28960,
  "end_ms": 30400,
  "text": "计划招66人"
 },
 {
  "id": 19624,
  "sequence_no": 16,
  "start_ms": 30400,
  "end_ms": 31680,
  "text": "首轮只录了一个"
 },
 {
  "id": 19625,
  "sequence_no": 17,
  "start_ms": 31680,
  "end_ms": 33360,
  "text": "缺额率98%"
 },
 {
  "id": 19626,
  "sequence_no": 18,
  "start_ms": 33360,
  "end_ms": 35160,
  "text": "招生班的老师打开系统一看"
 },
 {
  "id": 19627,
  "sequence_no": 19,
  "start_ms": 35160,
  "end_ms": 36640,
  "text": "差点没背过气去"
 },
 {
  "id": 19628,
  "sequence_no": 20,
  "start_ms": 36640,
  "end_ms": 40040,
  "text": "广西那边26所民办本科物理类专业组"
 },
 {
  "id": 19629,
  "sequence_no": 21,
  "start_ms": 40040,
  "end_ms": 42720,
  "text": "首轮投档集体挂领一片空白"
 },
 {
  "id": 19630,
  "sequence_no": 22,
  "start_ms": 42720,
  "end_ms": 44120,
  "text": "黑龙江物理类本科县"
 },
 {
  "id": 19631,
  "sequence_no": 23,
  "start_ms": 44120,
  "end_ms": 46120,
  "text": "从340分降到300分"
 },
 {
  "id": 19632,
  "sequence_no": 24,
  "start_ms": 46120,
  "end_ms": 47120,
  "text": "降了40分"
 },
 {
  "id": 19633,
  "sequence_no": 25,
  "start_ms": 47120,
  "end_ms": 48400,
  "text": "还是没人报"
 },
 {
  "id": 19634,
  "sequence_no": 26,
  "start_ms": 48400,
  "end_ms": 49360,
  "text": "机灵更狠"
 },
 {
  "id": 19635,
  "sequence_no": 27,
  "start_ms": 49360,
  "end_ms": 51440,
  "text": "长春建筑学院第二轮征集"
 },
 {
  "id": 19636,
  "sequence_no": 28,
  "start_ms": 51440,
  "end_ms": 53160,
  "text": "降到了281分"
 },
 {
  "id": 19637,
  "sequence_no": 29,
  "start_ms": 53160,
  "end_ms": 54800,
  "text": "281分上本科"
 },
 {
  "id": 19638,
  "sequence_no": 30,
  "start_ms": 54800,
  "end_ms": 55800,
  "text": "放5年前"
 },
 {
  "id": 19639,
  "sequence_no": 31,
  "start_ms": 55800,
  "end_ms": 56440,
  "text": "你敢信"
 },
 {
  "id": 19640,
  "sequence_no": 32,
  "start_ms": 56440,
  "end_ms": 57160,
  "text": "全国层面"
 },
 {
  "id": 19641,
  "sequence_no": 33,
  "start_ms": 57160,
  "end_ms": 58480,
  "text": "2025到2026年"
 },
 {
  "id": 19642,
  "sequence_no": 34,
  "start_ms": 58480,
  "end_ms": 60839,
  "text": "68所民办高校直接停止招生"
 },
 {
  "id": 19643,
  "sequence_no": 35,
  "start_ms": 60839,
  "end_ms": 63239,
  "text": "广东省教育厅委员副厅长把话挑明了"
 },
 {
  "id": 19644,
  "sequence_no": 36,
  "start_ms": 63239,
  "end_ms": 65200,
  "text": "不再增加任何一所民办大学"
 },
 {
  "id": 19645,
  "sequence_no": 37,
  "start_ms": 65200,
  "end_ms": 66240,
  "text": "这不是寒冬"
 },
 {
  "id": 19646,
  "sequence_no": 38,
  "start_ms": 66240,
  "end_ms": 67920,
  "text": "这是一场迟来的清算"
 },
 {
  "id": 19647,
  "sequence_no": 39,
  "start_ms": 67920,
  "end_ms": 69240,
  "text": "凭啥没人报了"
 },
 {
  "id": 19648,
  "sequence_no": 40,
  "start_ms": 69240,
  "end_ms": 69920,
  "text": "钱"
 },
 {
  "id": 19649,
  "sequence_no": 41,
  "start_ms": 69920,
  "end_ms": 73000,
  "text": "公办本科一年学费4500到6500元"
 },
 {
  "id": 19650,
  "sequence_no": 42,
  "start_ms": 73000,
  "end_ms": 74600,
  "text": "四年下赖3万左右"
 },
 {
  "id": 19651,
  "sequence_no": 43,
  "start_ms": 74600,
  "end_ms": 77000,
  "text": "民办本科根据2026年统计"
 },
 {
  "id": 19652,
  "sequence_no": 44,
  "start_ms": 77000,
  "end_ms": 80080,
  "text": "244所民办本科普通类专业学费"
 },
 {
  "id": 19653,
  "sequence_no": 45,
  "start_ms": 80080,
  "end_ms": 82000,
  "text": "中位数22800元"
 },
 {
  "id": 19654,
  "sequence_no": 46,
  "start_ms": 82000,
  "end_ms": 84080,
  "text": "平均23930元"
 },
 {
  "id": 19655,
  "sequence_no": 47,
  "start_ms": 84080,
  "end_ms": 85759,
  "text": "最贵的上海新卫学院"
 },
 {
  "id": 19656,
  "sequence_no": 48,
  "start_ms": 85759,
  "end_ms": 88039,
  "text": "一年149985元"
 },
 {
  "id": 19657,
  "sequence_no": 49,
  "start_ms": 88040,
  "end_ms": 88800,
  "text": "四年下来"
 },
 {
  "id": 19658,
  "sequence_no": 50,
  "start_ms": 88800,
  "end_ms": 91280,
  "text": "光学费加生活费奔着20万去"
 },
 {
  "id": 19659,
  "sequence_no": 51,
  "start_ms": 91280,
  "end_ms": 92840,
  "text": "你说这钱花的值也行"
 },
 {
  "id": 19660,
  "sequence_no": 52,
  "start_ms": 92840,
  "end_ms": 93560,
  "text": "问题是"
 },
 {
  "id": 19661,
  "sequence_no": 53,
  "start_ms": 93560,
  "end_ms": 95200,
  "text": "花了钱学不着东西"
 },
 {
  "id": 19662,
  "sequence_no": 54,
  "start_ms": 95200,
  "end_ms": 97320,
  "text": "很多民办高校的生存逻辑是啥"
 },
 {
  "id": 19663,
  "sequence_no": 55,
  "start_ms": 97320,
  "end_ms": 99200,
  "text": "中招生不中教学"
 },
 {
  "id": 19664,
  "sequence_no": 56,
  "start_ms": 99200,
  "end_ms": 102120,
  "text": "大量招兼职教师和刚毕业的年轻老师"
 },
 {
  "id": 19665,
  "sequence_no": 57,
  "start_ms": 102120,
  "end_ms": 104280,
  "text": "有水平的老教授寥寥无几"
 },
 {
  "id": 19666,
  "sequence_no": 58,
  "start_ms": 104280,
  "end_ms": 107280,
  "text": "老师拿着20年前的老教材照本宣课"
 },
 {
  "id": 19667,
  "sequence_no": 59,
  "start_ms": 107280,
  "end_ms": 109320,
  "text": "学生上课昏昏欲睡"
 },
 {
  "id": 19668,
  "sequence_no": 60,
  "start_ms": 109320,
  "end_ms": 110400,
  "text": "你混你的文凭"
 },
 {
  "id": 19669,
  "sequence_no": 61,
  "start_ms": 110400,
  "end_ms": 111400,
  "text": "我混我的工资"
 },
 {
  "id": 19670,
  "sequence_no": 62,
  "start_ms": 111400,
  "end_ms": 112200,
  "text": "各不影响"
 },
 {
  "id": 19671,
  "sequence_no": 63,
  "start_ms": 112200,
  "end_ms": 113040,
  "text": "更逗的是"
 },
 {
  "id": 19672,
  "sequence_no": 64,
  "start_ms": 113040,
  "end_ms": 115480,
  "text": "专业设置都2026年了"
 },
 {
  "id": 19673,
  "sequence_no": 65,
  "start_ms": 115480,
  "end_ms": 117520,
  "text": "还在大量开什么工商管理"
 },
 {
  "id": 19674,
  "sequence_no": 66,
  "start_ms": 117520,
  "end_ms": 119160,
  "text": "市场营销物流管理"
 },
 {
  "id": 19675,
  "sequence_no": 67,
  "start_ms": 119160,
  "end_ms": 121840,
  "text": "这些专业在公办本科都过剩了"
 },
 {
  "id": 19676,
  "sequence_no": 68,
  "start_ms": 121840,
  "end_ms": 123720,
  "text": "民办本科还在开"
 },
 {
  "id": 19677,
  "sequence_no": 69,
  "start_ms": 123720,
  "end_ms": 125000,
  "text": "学生学了4年"
 },
 {
  "id": 19678,
  "sequence_no": 70,
  "start_ms": 125000,
  "end_ms": 126880,
  "text": "毕业完全找不到对口工作"
 },
 {
  "id": 19679,
  "sequence_no": 71,
  "start_ms": 126880,
  "end_ms": 128880,
  "text": "学校为了让就业数据好看"
 },
 {
  "id": 19680,
  "sequence_no": 72,
  "start_ms": 128880,
  "end_ms": 131600,
  "text": "逼着学生随便找公司签三方协议"
 },
 {
  "id": 19681,
  "sequence_no": 73,
  "start_ms": 131600,
  "end_ms": 133840,
  "text": "表面看就业率超过95%"
 },
 {
  "id": 19682,
  "sequence_no": 74,
  "start_ms": 133840,
  "end_ms": 134760,
  "text": "实际呢"
 },
 {
  "id": 19683,
  "sequence_no": 75,
  "start_ms": 134760,
  "end_ms": 135880,
  "text": "毕业即失业"
 },
 {
  "id": 19684,
  "sequence_no": 76,
  "start_ms": 135880,
  "end_ms": 137200,
  "text": "或者毕业即转行"
 },
 {
  "id": 19685,
  "sequence_no": 77,
  "start_ms": 137200,
  "end_ms": 137960,
  "text": "家长不傻"
 },
 {
  "id": 19686,
  "sequence_no": 78,
  "start_ms": 137960,
  "end_ms": 138880,
  "text": "开始算账了"
 },
 {
  "id": 19687,
  "sequence_no": 79,
  "start_ms": 138880,
  "end_ms": 140560,
  "text": "花20万读个民办本科"
 },
 {
  "id": 19688,
  "sequence_no": 80,
  "start_ms": 140560,
  "end_ms": 141920,
  "text": "毕业月薪三四千"
 },
 {
  "id": 19689,
  "sequence_no": 81,
  "start_ms": 141920,
  "end_ms": 143120,
  "text": "扣完社保房租"
 },
 {
  "id": 19690,
  "sequence_no": 82,
  "start_ms": 143120,
  "end_ms": 144480,
  "text": "到手勉强购吃饭"
 },
 {
  "id": 19691,
  "sequence_no": 83,
  "start_ms": 144480,
  "end_ms": 146400,
  "text": "投入产出比严重倒挂"
 },
 {
  "id": 19692,
  "sequence_no": 84,
  "start_ms": 146400,
  "end_ms": 147480,
  "text": "以前家上觉得"
 },
 {
  "id": 19693,
  "sequence_no": 85,
  "start_ms": 147480,
  "end_ms": 148880,
  "text": "本科比专科强"
 },
 {
  "id": 19694,
  "sequence_no": 86,
  "start_ms": 148880,
  "end_ms": 150240,
  "text": "哪怕是个民办本科"
 },
 {
  "id": 19695,
  "sequence_no": 87,
  "start_ms": 150240,
  "end_ms": 151520,
  "text": "也比公办专科好"
 },
 {
  "id": 19696,
  "sequence_no": 88,
  "start_ms": 151520,
  "end_ms": 153360,
  "text": "现在这个观念正在崩塌"
 },
 {
  "id": 19697,
  "sequence_no": 89,
  "start_ms": 153360,
  "end_ms": 154400,
  "text": "与其花十几万"
 },
 {
  "id": 19698,
  "sequence_no": 90,
  "start_ms": 154400,
  "end_ms": 155760,
  "text": "读个听起来像本科"
 },
 {
  "id": 19699,
  "sequence_no": 91,
  "start_ms": 155760,
  "end_ms": 157560,
  "text": "但毕业后找不到工作的学校"
 },
 {
  "id": 19700,
  "sequence_no": 92,
  "start_ms": 157560,
  "end_ms": 158960,
  "text": "不如去公办专科"
 },
 {
  "id": 19701,
  "sequence_no": 93,
  "start_ms": 158960,
  "end_ms": 160360,
  "text": "读个能吃饭的专业"
 },
 {
  "id": 19702,
  "sequence_no": 94,
  "start_ms": 160360,
  "end_ms": 162320,
  "text": "这边民办本科跪着求人"
 },
 {
  "id": 19703,
  "sequence_no": 95,
  "start_ms": 162320,
  "end_ms": 164560,
  "text": "那边新型民办大学挤破头"
 },
 {
  "id": 19704,
  "sequence_no": 96,
  "start_ms": 164560,
  "end_ms": 165640,
  "text": "福耀科技大学"
 },
 {
  "id": 19705,
  "sequence_no": 97,
  "start_ms": 165640,
  "end_ms": 167560,
  "text": "学费一年5460元"
 },
 {
  "id": 19706,
  "sequence_no": 98,
  "start_ms": 167560,
  "end_ms": 169200,
  "text": "比很多公办还便宜"
 },
 {
  "id": 19707,
  "sequence_no": 99,
  "start_ms": 169200,
  "end_ms": 170440,
  "text": "配备了15个院士"
 },
 {
  "id": 19708,
  "sequence_no": 100,
  "start_ms": 170440,
  "end_ms": 171680,
  "text": "走精英培养路线"
 },
 {
  "id": 19709,
  "sequence_no": 101,
  "start_ms": 171680,
  "end_ms": 174640,
  "text": "2026年在广西录到最高672分"
 },
 {
  "id": 19710,
  "sequence_no": 102,
  "start_ms": 174679,
  "end_ms": 177200,
  "text": "这个分数去年能报南京大学和中科大"
 },
 {
  "id": 19711,
  "sequence_no": 103,
  "start_ms": 177200,
  "end_ms": 179440,
  "text": "在江西最低617分"
 },
 {
  "id": 19712,
  "sequence_no": 104,
  "start_ms": 179440,
  "end_ms": 181480,
  "text": "比哈工大在当地某些专业组的"
 },
 {
  "id": 19713,
  "sequence_no": 105,
  "start_ms": 181480,
  "end_ms": 182679,
  "text": "头档线还高"
 },
 {
  "id": 19714,
  "sequence_no": 106,
  "start_ms": 182679,
  "end_ms": 183839,
  "text": "同样都是民办"
 },
 {
  "id": 19715,
  "sequence_no": 107,
  "start_ms": 183839,
  "end_ms": 185440,
  "text": "差距咋就这么大呢"
 },
 {
  "id": 19716,
  "sequence_no": 108,
  "start_ms": 185440,
  "end_ms": 186519,
  "text": "更魔幻的是"
 },
 {
  "id": 19717,
  "sequence_no": 109,
  "start_ms": 186519,
  "end_ms": 187519,
  "text": "职校火了"
 },
 {
  "id": 19718,
  "sequence_no": 110,
  "start_ms": 187519,
  "end_ms": 189399,
  "text": "北京昌平职校招生现场"
 },
 {
  "id": 19719,
  "sequence_no": 111,
  "start_ms": 189399,
  "end_ms": 190559,
  "text": "让凌晨三点"
 },
 {
  "id": 19720,
  "sequence_no": 112,
  "start_ms": 190559,
  "end_ms": 191560,
  "text": "支帐棚排队"
 },
 {
  "id": 19721,
  "sequence_no": 113,
  "start_ms": 191560,
  "end_ms": 193279,
  "text": "广州一家中职开放日"
 },
 {
  "id": 19722,
  "sequence_no": 114,
  "start_ms": 193279,
  "end_ms": 195000,
  "text": "一天来了4000多家涨"
 },
 {
  "id": 19723,
  "sequence_no": 115,
  "start_ms": 195000,
  "end_ms": 197320,
  "text": "广州首批3加4中本贯通试点"
 },
 {
  "id": 19724,
  "sequence_no": 116,
  "start_ms": 197320,
  "end_ms": 200040,
  "text": "40个名额引来6366人报名"
 },
 {
  "id": 19725,
  "sequence_no": 117,
  "start_ms": 200040,
  "end_ms": 201679,
  "text": "159人抢一个名额"
 },
 {
  "id": 19726,
  "sequence_no": 118,
  "start_ms": 201679,
  "end_ms": 203839,
  "text": "暴露比连不少985热门专业"
 },
 {
  "id": 19727,
  "sequence_no": 119,
  "start_ms": 203840,
  "end_ms": 205040,
  "text": "都甘拜下风"
 },
 {
  "id": 19728,
  "sequence_no": 120,
  "start_ms": 205040,
  "end_ms": 206640,
  "text": "你说这事讽刺不讽刺"
 },
 {
  "id": 19729,
  "sequence_no": 121,
  "start_ms": 206640,
  "end_ms": 207600,
  "text": "过去20年"
 },
 {
  "id": 19730,
  "sequence_no": 122,
  "start_ms": 207600,
  "end_ms": 209280,
  "text": "民办高校的财务模型"
 },
 {
  "id": 19731,
  "sequence_no": 123,
  "start_ms": 209280,
  "end_ms": 210760,
  "text": "根本不是教育模型"
 },
 {
  "id": 19732,
  "sequence_no": 124,
  "start_ms": 210760,
  "end_ms": 211760,
  "text": "是资金盘"
 },
 {
  "id": 19733,
  "sequence_no": 125,
  "start_ms": 211760,
  "end_ms": 213080,
  "text": "一年招3000人"
 },
 {
  "id": 19734,
  "sequence_no": 126,
  "start_ms": 213080,
  "end_ms": 214080,
  "text": "学费25000"
 },
 {
  "id": 19735,
  "sequence_no": 127,
  "start_ms": 214080,
  "end_ms": 215680,
  "text": "收进来7500万"
 },
 {
  "id": 19736,
  "sequence_no": 128,
  "start_ms": 215680,
  "end_ms": 217800,
  "text": "这笔钱到账那天就不是你的了"
 },
 {
  "id": 19737,
  "sequence_no": 129,
  "start_ms": 217800,
  "end_ms": 218880,
  "text": "填去年的骷髅"
 },
 {
  "id": 19738,
  "sequence_no": 130,
  "start_ms": 218880,
  "end_ms": 219880,
  "text": "还银行贷款"
 },
 {
  "id": 19739,
  "sequence_no": 131,
  "start_ms": 219880,
  "end_ms": 220920,
  "text": "补托欠的工资"
 },
 {
  "id": 19740,
  "sequence_no": 132,
  "start_ms": 220920,
  "end_ms": 222280,
  "text": "活下来的前提就是"
 },
 {
  "id": 19741,
  "sequence_no": 133,
  "start_ms": 222280,
  "end_ms": 223760,
  "text": "风永远别停"
 },
 {
  "id": 19742,
  "sequence_no": 134,
  "start_ms": 223760,
  "end_ms": 225840,
  "text": "风就是每年新生的数量"
 },
 {
  "id": 19743,
  "sequence_no": 135,
  "start_ms": 225840,
  "end_ms": 227160,
  "text": "现在风停了"
 },
 {
  "id": 19744,
  "sequence_no": 136,
  "start_ms": 227160,
  "end_ms": 228800,
  "text": "2026年高考报名人数"
 },
 {
  "id": 19745,
  "sequence_no": 137,
  "start_ms": 228800,
  "end_ms": 230240,
  "text": "比去年少四五十万"
 },
 {
  "id": 19746,
  "sequence_no": 138,
  "start_ms": 230240,
  "end_ms": 232120,
  "text": "真正的断崖在12年后"
 },
 {
  "id": 19747,
  "sequence_no": 139,
  "start_ms": 232120,
  "end_ms": 234760,
  "text": "2016年出生1786万"
 },
 {
  "id": 19748,
  "sequence_no": 140,
  "start_ms": 234760,
  "end_ms": 237120,
  "text": "去年只出生了792万"
 },
 {
  "id": 19749,
  "sequence_no": 141,
  "start_ms": 237120,
  "end_ms": 238800,
  "text": "腰斩更荒诞的是啥"
 },
 {
  "id": 19750,
  "sequence_no": 142,
  "start_ms": 238800,
  "end_ms": 240480,
  "text": "真正认真办学的民办"
 },
 {
  "id": 19751,
  "sequence_no": 143,
  "start_ms": 240480,
  "end_ms": 241480,
  "text": "死得更快"
 },
 {
  "id": 19752,
  "sequence_no": 144,
  "start_ms": 241480,
  "end_ms": 242400,
  "text": "踏实搞教学"
 },
 {
  "id": 19753,
  "sequence_no": 145,
  "start_ms": 242400,
  "end_ms": 243200,
  "text": "更新设备"
 },
 {
  "id": 19754,
  "sequence_no": 146,
  "start_ms": 243200,
  "end_ms": 244600,
  "text": "按时发工资的学校"
 },
 {
  "id": 19755,
  "sequence_no": 147,
  "start_ms": 244600,
  "end_ms": 245480,
  "text": "账上现金"
 },
 {
  "id": 19756,
  "sequence_no": 148,
  "start_ms": 245480,
  "end_ms": 247000,
  "text": "只够撑一个学期"
 },
 {
  "id": 19757,
  "sequence_no": 149,
  "start_ms": 247000,
  "end_ms": 249000,
  "text": "旁边靠砸广告忽悠学生进来"
 },
 {
  "id": 19758,
  "sequence_no": 150,
  "start_ms": 249000,
  "end_ms": 250280,
  "text": "时讯课上看PPT"
 },
 {
  "id": 19759,
  "sequence_no": 151,
  "start_ms": 250280,
  "end_ms": 252360,
  "text": "老师在台上念百度百科的学校"
 },
 {
  "id": 19760,
  "sequence_no": 152,
  "start_ms": 252360,
  "end_ms": 254680,
  "text": "户头上还趴着前几年攒的利润"
 },
 {
  "id": 19761,
  "sequence_no": 153,
  "start_ms": 254680,
  "end_ms": 255960,
  "text": "劣币驱逐两名"
 },
 {
  "id": 19762,
  "sequence_no": 154,
  "start_ms": 255960,
  "end_ms": 257240,
  "text": "在民办教育领域"
 },
 {
  "id": 19763,
  "sequence_no": 155,
  "start_ms": 257240,
  "end_ms": 258880,
  "text": "上演了整整20年"
 },
 {
  "id": 19764,
  "sequence_no": 156,
  "start_ms": 258880,
  "end_ms": 260280,
  "text": "全国人大今年出了报告"
 },
 {
  "id": 19765,
  "sequence_no": 157,
  "start_ms": 260280,
  "end_ms": 261360,
  "text": "主题就一句"
 },
 {
  "id": 19766,
  "sequence_no": 158,
  "start_ms": 261360,
  "end_ms": 262640,
  "text": "完善民办高校"
 },
 {
  "id": 19767,
  "sequence_no": 159,
  "start_ms": 262640,
  "end_ms": 263960,
  "text": "有序退出机制"
 },
 {
  "id": 19768,
  "sequence_no": 160,
  "start_ms": 263960,
  "end_ms": 265360,
  "text": "播出我给翻译过来就是"
 },
 {
  "id": 19769,
  "sequence_no": 161,
  "start_ms": 265360,
  "end_ms": 266800,
  "text": "怎么让该死的学校"
 },
 {
  "id": 19770,
  "sequence_no": 162,
  "start_ms": 266800,
  "end_ms": 267680,
  "text": "体面的死"
 },
 {
  "id": 19771,
  "sequence_no": 163,
  "start_ms": 267680,
  "end_ms": 269800,
  "text": "怎么把剩下的学生和老师安置好"
 },
 {
  "id": 19772,
  "sequence_no": 164,
  "start_ms": 269800,
  "end_ms": 271440,
  "text": "民办大学的黄金时代"
 },
 {
  "id": 19773,
  "sequence_no": 165,
  "start_ms": 271440,
  "end_ms": 272040,
  "text": "结束了"
 },
 {
  "id": 19774,
  "sequence_no": 166,
  "start_ms": 272040,
  "end_ms": 273320,
  "text": "不是学生不读书了"
 },
 {
  "id": 19775,
  "sequence_no": 167,
  "start_ms": 273320,
  "end_ms": 274520,
  "text": "是家人和学生"
 },
 {
  "id": 19776,
  "sequence_no": 168,
  "start_ms": 274520,
  "end_ms": 276120,
  "text": "终于算清了那笔账"
 },
 {
  "id": 19777,
  "sequence_no": 169,
  "start_ms": 276120,
  "end_ms": 278320,
  "text": "花20万买张注水文聘"
 },
 {
  "id": 19778,
  "sequence_no": 170,
  "start_ms": 278320,
  "end_ms": 279160,
  "text": "不如学门"
 },
 {
  "id": 19779,
  "sequence_no": 171,
  "start_ms": 279160,
  "end_ms": 280600,
  "text": "石大师的手艺"
 },
 {
  "id": 19780,
  "sequence_no": 172,
  "start_ms": 280600,
  "end_ms": 282400,
  "text": "当本科两个字不在值钱"
 },
 {
  "id": 19781,
  "sequence_no": 173,
  "start_ms": 282400,
  "end_ms": 283960,
  "text": "能让孩子端上饭碗的路"
 },
 {
  "id": 19782,
  "sequence_no": 174,
  "start_ms": 283960,
  "end_ms": 285160,
  "text": "就会越来越值钱"
 },
 {
  "id": 19783,
  "sequence_no": 175,
  "start_ms": 285160,
  "end_ms": 286440,
  "text": "别让本科这两个字"
 },
 {
  "id": 19784,
  "sequence_no": 176,
  "start_ms": 286440,
  "end_ms": 287680,
  "text": "绑架了你的人生"
 }
]