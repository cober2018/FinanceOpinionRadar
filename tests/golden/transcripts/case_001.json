[
 {
  "id": 19003,
  "sequence_no": 0,
  "start_ms": 0,
  "end_ms": 2600,
  "text": "Hello 大家好 歡迎回到陽光財經 我是Sanny"
 },
 {
  "id": 19004,
  "sequence_no": 1,
  "start_ms": 2600,
  "end_ms": 5640,
  "text": "今天是2016年9月16號 星期三"
 },
 {
  "id": 19005,
  "sequence_no": 2,
  "start_ms": 5640,
  "end_ms": 10400,
  "text": "標庫指數今天下跌了33.92點 跌幅百分0.45"
 },
 {
  "id": 19006,
  "sequence_no": 3,
  "start_ms": 10400,
  "end_ms": 12960,
  "text": "收盤點位7551點"
 },
 {
  "id": 19007,
  "sequence_no": 4,
  "start_ms": 12960,
  "end_ms": 16600,
  "text": "那麼前期7620高點早就失手了"
 },
 {
  "id": 19008,
  "sequence_no": 5,
  "start_ms": 16600,
  "end_ms": 19800,
  "text": "今天 標庫指數還跌破了60日線"
 },
 {
  "id": 19009,
  "sequence_no": 6,
  "start_ms": 19800,
  "end_ms": 22400,
  "text": "出現了中期支撐線上的破位"
 },
 {
  "id": 19010,
  "sequence_no": 7,
  "start_ms": 22400,
  "end_ms": 24920,
  "text": "昨天我們說 今天會崩嗎?"
 },
 {
  "id": 19011,
  "sequence_no": 8,
  "start_ms": 24920,
  "end_ms": 29200,
  "text": "今天是沒有崩 只不過日內跌幅有點嚇人"
 },
 {
  "id": 19012,
  "sequence_no": 9,
  "start_ms": 29200,
  "end_ms": 33860,
  "text": "近期因為持續整理 沒有穩定的上漲或下跌趨勢"
 },
 {
  "id": 19013,
  "sequence_no": 10,
  "start_ms": 33860,
  "end_ms": 37560,
  "text": "均線系統糾纏 給不出什麼方向上的指導"
 },
 {
  "id": 19014,
  "sequence_no": 11,
  "start_ms": 37560,
  "end_ms": 40860,
  "text": "既然前期高點突破後得而復失"
 },
 {
  "id": 19015,
  "sequence_no": 12,
  "start_ms": 40860,
  "end_ms": 43960,
  "text": "標股指數將重新無方向性地震盪"
 },
 {
  "id": 19016,
  "sequence_no": 13,
  "start_ms": 43960,
  "end_ms": 45760,
  "text": "上漲相當乏力"
 },
 {
  "id": 19017,
  "sequence_no": 14,
  "start_ms": 45760,
  "end_ms": 48000,
  "text": "如果標股指數進一步下跌"
 },
 {
  "id": 19018,
  "sequence_no": 15,
  "start_ms": 48000,
  "end_ms": 51360,
  "text": "預計在7400點也能獲得強制稱"
 },
 {
  "id": 19019,
  "sequence_no": 16,
  "start_ms": 51360,
  "end_ms": 54620,
  "text": "納斯達克指數今天下跌了3.15點"
 },
 {
  "id": 19020,
  "sequence_no": 17,
  "start_ms": 54620,
  "end_ms": 56360,
  "text": "跌幅只有1萬分之1"
 },
 {
  "id": 19021,
  "sequence_no": 18,
  "start_ms": 56360,
  "end_ms": 58320,
  "text": "日K線收了個小陰線"
 },
 {
  "id": 19022,
  "sequence_no": 19,
  "start_ms": 58320,
  "end_ms": 61120,
  "text": "勉强挂在60天均线上"
 },
 {
  "id": 19023,
  "sequence_no": 20,
  "start_ms": 61120,
  "end_ms": 63720,
  "text": "大盘宽幅震荡了快一个季度了"
 },
 {
  "id": 19024,
  "sequence_no": 21,
  "start_ms": 63720,
  "end_ms": 66320,
  "text": "人看不到震荡结束的信号"
 },
 {
  "id": 19025,
  "sequence_no": 22,
  "start_ms": 66320,
  "end_ms": 69520,
  "text": "预计纳斯达克指数也未必要大跌"
 },
 {
  "id": 19026,
  "sequence_no": 23,
  "start_ms": 69520,
  "end_ms": 73120,
  "text": "但是震荡消耗时间也是相当麻烦"
 },
 {
  "id": 19027,
  "sequence_no": 24,
  "start_ms": 73120,
  "end_ms": 74920,
  "text": "没有赚钱效应"
 },
 {
  "id": 19028,
  "sequence_no": 25,
  "start_ms": 74920,
  "end_ms": 76720,
  "text": "没有明星龙头"
 },
 {
  "id": 19029,
  "sequence_no": 26,
  "start_ms": 76720,
  "end_ms": 78720,
  "text": "市场正在一个垃圾时间当中"
 },
 {
  "id": 19030,
  "sequence_no": 27,
  "start_ms": 78720,
  "end_ms": 80720,
  "text": "寻找下一步的方向"
 },
 {
  "id": 19031,
  "sequence_no": 28,
  "start_ms": 80720,
  "end_ms": 83920,
  "text": "今天市场迎来了三年来的首次加息"
 },
 {
  "id": 19032,
  "sequence_no": 29,
  "start_ms": 83920,
  "end_ms": 85120,
  "text": "下午两点"
 },
 {
  "id": 19033,
  "sequence_no": 30,
  "start_ms": 85120,
  "end_ms": 86720,
  "text": "会议声明发布"
 },
 {
  "id": 19034,
  "sequence_no": 31,
  "start_ms": 86720,
  "end_ms": 90440,
  "text": "美联储按市场预期的那样加息了25个基点"
 },
 {
  "id": 19035,
  "sequence_no": 32,
  "start_ms": 90440,
  "end_ms": 92480,
  "text": "标普指数小幅跳水"
 },
 {
  "id": 19036,
  "sequence_no": 33,
  "start_ms": 92480,
  "end_ms": 94840,
  "text": "2点半过时开始讲话"
 },
 {
  "id": 19037,
  "sequence_no": 34,
  "start_ms": 94840,
  "end_ms": 97480,
  "text": "结果是一边讲一边跌"
 },
 {
  "id": 19038,
  "sequence_no": 35,
  "start_ms": 97480,
  "end_ms": 99280,
  "text": "从头跌到尾"
 },
 {
  "id": 19039,
  "sequence_no": 36,
  "start_ms": 99280,
  "end_ms": 101480,
  "text": "幸好只讲了7分多钟"
 },
 {
  "id": 19040,
  "sequence_no": 37,
  "start_ms": 101480,
  "end_ms": 105640,
  "text": "要是讲一天股市可能得跌到姥姥家了"
 },
 {
  "id": 19041,
  "sequence_no": 38,
  "start_ms": 105640,
  "end_ms": 108880,
  "text": "这次加息的投票决定没有任何反对票"
 },
 {
  "id": 19042,
  "sequence_no": 39,
  "start_ms": 108880,
  "end_ms": 111320,
  "text": "美联储票尾达成了一致"
 },
 {
  "id": 19043,
  "sequence_no": 40,
  "start_ms": 111320,
  "end_ms": 113360,
  "text": "简短的会议声明显示"
 },
 {
  "id": 19044,
  "sequence_no": 41,
  "start_ms": 113360,
  "end_ms": 117640,
  "text": "委員會決定將聯邦基金利率上調0.25個百分點"
 },
 {
  "id": 19045,
  "sequence_no": 42,
  "start_ms": 117640,
  "end_ms": 121200,
  "text": "利率升至3.75%到4%之間"
 },
 {
  "id": 19046,
  "sequence_no": 43,
  "start_ms": 121200,
  "end_ms": 123760,
  "text": "經濟活動正穩步擴張"
 },
 {
  "id": 19047,
  "sequence_no": 44,
  "start_ms": 123760,
  "end_ms": 128800,
  "text": "儘管地緣政治局勢發展等因素導致不確定性依然較高"
 },
 {
  "id": 19048,
  "sequence_no": 45,
  "start_ms": 128800,
  "end_ms": 131400,
  "text": "但國內消費依然保持韌性"
 },
 {
  "id": 19049,
  "sequence_no": 46,
  "start_ms": 131400,
  "end_ms": 135800,
  "text": "生產率增長強勁 資本投資也十分活躍"
 },
 {
  "id": 19050,
  "sequence_no": 47,
  "start_ms": 135800,
  "end_ms": 138800,
  "text": "就業增長與勞動力增長保持同步"
 },
 {
  "id": 19051,
  "sequence_no": 48,
  "start_ms": 138800,
  "end_ms": 142240,
  "text": "失業率變化不大 通脹依然高企"
 },
 {
  "id": 19052,
  "sequence_no": 49,
  "start_ms": 142240,
  "end_ms": 147740,
  "text": "今天的政策行动将有助于更快的实现委员会设定的2%的目标"
 },
 {
  "id": 19053,
  "sequence_no": 50,
  "start_ms": 147740,
  "end_ms": 150340,
  "text": "委员会将致力于稳定物价"
 },
 {
  "id": 19054,
  "sequence_no": 51,
  "start_ms": 150340,
  "end_ms": 154240,
  "text": "卧实的讲话也承认经济的各项数据不错"
 },
 {
  "id": 19055,
  "sequence_no": 52,
  "start_ms": 154240,
  "end_ms": 157440,
  "text": "失业率也稳定在充分就业的数值上"
 },
 {
  "id": 19056,
  "sequence_no": 53,
  "start_ms": 157440,
  "end_ms": 159540,
  "text": "唯独通胀有点高"
 },
 {
  "id": 19057,
  "sequence_no": 54,
  "start_ms": 159540,
  "end_ms": 161740,
  "text": "而且长时间下不来"
 },
 {
  "id": 19058,
  "sequence_no": 55,
  "start_ms": 161740,
  "end_ms": 163540,
  "text": "让人十分恼火"
 },
 {
  "id": 19059,
  "sequence_no": 56,
  "start_ms": 163540,
  "end_ms": 168340,
  "text": "他讲话的主要内容就是反复强调要把通胀降下来"
 },
 {
  "id": 19060,
  "sequence_no": 57,
  "start_ms": 168340,
  "end_ms": 170540,
  "text": "听起来鹰派十足"
 },
 {
  "id": 19061,
  "sequence_no": 58,
  "start_ms": 170540,
  "end_ms": 176040,
  "text": "但是我认为这次美联储的决定和态度表面上看重大利空"
 },
 {
  "id": 19062,
  "sequence_no": 59,
  "start_ms": 176040,
  "end_ms": 180240,
  "text": "实际上市场转入熊市的可能性也没有那么大"
 },
 {
  "id": 19063,
  "sequence_no": 60,
  "start_ms": 180240,
  "end_ms": 183040,
  "text": "从会议材料PPT中可以看出"
 },
 {
  "id": 19064,
  "sequence_no": 61,
  "start_ms": 183040,
  "end_ms": 184840,
  "text": "经济数据稳定向好"
 },
 {
  "id": 19065,
  "sequence_no": 62,
  "start_ms": 184840,
  "end_ms": 188440,
  "text": "美联储官员对未来的预期也是相当美好的"
 },
 {
  "id": 19066,
  "sequence_no": 63,
  "start_ms": 188440,
  "end_ms": 190740,
  "text": "首先是对GDP的预测"
 },
 {
  "id": 19067,
  "sequence_no": 64,
  "start_ms": 190740,
  "end_ms": 194340,
  "text": "看这种统计图我们可以直接看红色短线"
 },
 {
  "id": 19068,
  "sequence_no": 65,
  "start_ms": 194340,
  "end_ms": 198440,
  "text": "对应的数值是美联储官员预测的中位数"
 },
 {
  "id": 19069,
  "sequence_no": 66,
  "start_ms": 198440,
  "end_ms": 207800,
  "text": "预计美国真实GDP在2026年为2.3%,2027年为2.4%,远期则回落到2%的水平"
 },
 {
  "id": 19070,
  "sequence_no": 67,
  "start_ms": 207800,
  "end_ms": 211960,
  "text": "美联储官员对通胀的预期也是先升后降"
 },
 {
  "id": 19071,
  "sequence_no": 68,
  "start_ms": 211960,
  "end_ms": 219760,
  "text": "在2026年,通胀的预期中位数达到了3.7%,高于6月预测时的3.3%"
 },
 {
  "id": 19072,
  "sequence_no": 69,
  "start_ms": 219760,
  "end_ms": 226440,
  "text": "在2027年就下降到了2.3%,但也高于上季度预测的2.2%"
 },
 {
  "id": 19073,
  "sequence_no": 70,
  "start_ms": 226440,
  "end_ms": 232840,
  "text": "2028年下降到2.1%,2029年就达到了2%的目标"
 },
 {
  "id": 19074,
  "sequence_no": 71,
  "start_ms": 232840,
  "end_ms": 239560,
  "text": "通胀远期会回落,但近期仍高于预期的情况,让市场感觉到担忧"
 },
 {
  "id": 19075,
  "sequence_no": 72,
  "start_ms": 239560,
  "end_ms": 247480,
  "text": "失业率则非常稳定,美联储预测,未来几年的失业率都将稳定在4.1%的水平"
 },
 {
  "id": 19076,
  "sequence_no": 73,
  "start_ms": 247480,
  "end_ms": 254680,
  "text": "远期达到4.2%,也就是说当前的失业率水平正好是美联储需要的充分就业"
 },
 {
  "id": 19077,
  "sequence_no": 74,
  "start_ms": 254680,
  "end_ms": 256920,
  "text": "完全不怎么需要担忧"
 },
 {
  "id": 19078,
  "sequence_no": 75,
  "start_ms": 256920,
  "end_ms": 259240,
  "text": "基于宏观数据都还可以"
 },
 {
  "id": 19079,
  "sequence_no": 76,
  "start_ms": 259240,
  "end_ms": 261320,
  "text": "就是通胀持续低烧"
 },
 {
  "id": 19080,
  "sequence_no": 77,
  "start_ms": 261320,
  "end_ms": 264360,
  "text": "所以美联储不得不加息应对"
 },
 {
  "id": 19081,
  "sequence_no": 78,
  "start_ms": 264360,
  "end_ms": 266600,
  "text": "在季末披露的点证图中"
 },
 {
  "id": 19082,
  "sequence_no": 79,
  "start_ms": 266600,
  "end_ms": 267800,
  "text": "我们可以看到"
 },
 {
  "id": 19083,
  "sequence_no": 80,
  "start_ms": 267800,
  "end_ms": 269560,
  "text": "今年大多数的点证"
 },
 {
  "id": 19084,
  "sequence_no": 81,
  "start_ms": 269560,
  "end_ms": 272760,
  "text": "是打在了4%到4.25%之间"
 },
 {
  "id": 19085,
  "sequence_no": 82,
  "start_ms": 272760,
  "end_ms": 275640,
  "text": "也就是说年内的两次议席会议"
 },
 {
  "id": 19086,
  "sequence_no": 83,
  "start_ms": 275640,
  "end_ms": 277560,
  "text": "还有可能再加息一次"
 },
 {
  "id": 19087,
  "sequence_no": 84,
  "start_ms": 277560,
  "end_ms": 280200,
  "text": "预计有可能是在12月份"
 },
 {
  "id": 19088,
  "sequence_no": 85,
  "start_ms": 280200,
  "end_ms": 282200,
  "text": "而到了2027年"
 },
 {
  "id": 19089,
  "sequence_no": 86,
  "start_ms": 282200,
  "end_ms": 286120,
  "text": "多數點證打在了4.25%到4.5%之間"
 },
 {
  "id": 19090,
  "sequence_no": 87,
  "start_ms": 286120,
  "end_ms": 288760,
  "text": "但這些官員並非絕對多數"
 },
 {
  "id": 19091,
  "sequence_no": 88,
  "start_ms": 288760,
  "end_ms": 292360,
  "text": "更多的人選擇在2027年不再加息"
 },
 {
  "id": 19092,
  "sequence_no": 89,
  "start_ms": 292360,
  "end_ms": 295400,
  "text": "2028年以後利率就開始下降了"
 },
 {
  "id": 19093,
  "sequence_no": 90,
  "start_ms": 295400,
  "end_ms": 297880,
  "text": "那這個信息就有點重要了"
 },
 {
  "id": 19094,
  "sequence_no": 91,
  "start_ms": 297880,
  "end_ms": 301240,
  "text": "本次加息週期的窗口打開之後"
 },
 {
  "id": 19095,
  "sequence_no": 92,
  "start_ms": 301240,
  "end_ms": 304760,
  "text": "也就只有兩到三次的加息就差不多結束了"
 },
 {
  "id": 19096,
  "sequence_no": 93,
  "start_ms": 304760,
  "end_ms": 306200,
  "text": "加息幅度不大"
 },
 {
  "id": 19097,
  "sequence_no": 94,
  "start_ms": 306200,
  "end_ms": 308360,
  "text": "如果能夠做到短頻快"
 },
 {
  "id": 19098,
  "sequence_no": 95,
  "start_ms": 308360,
  "end_ms": 310360,
  "text": "早點加完早點結束"
 },
 {
  "id": 19099,
  "sequence_no": 96,
  "start_ms": 310360,
  "end_ms": 312960,
  "text": "那么对股市的影响就会小得多"
 },
 {
  "id": 19100,
  "sequence_no": 97,
  "start_ms": 312960,
  "end_ms": 315280,
  "text": "你看2022年的加息周期"
 },
 {
  "id": 19101,
  "sequence_no": 98,
  "start_ms": 315280,
  "end_ms": 317320,
  "text": "幅度大,时间也长"
 },
 {
  "id": 19102,
  "sequence_no": 99,
  "start_ms": 317320,
  "end_ms": 320160,
  "text": "所以股市进入阶段性的熊市"
 },
 {
  "id": 19103,
  "sequence_no": 100,
  "start_ms": 320160,
  "end_ms": 322960,
  "text": "而本次加息的次数和时间"
 },
 {
  "id": 19104,
  "sequence_no": 101,
  "start_ms": 322960,
  "end_ms": 324760,
  "text": "按点证图的信息来看"
 },
 {
  "id": 19105,
  "sequence_no": 102,
  "start_ms": 324760,
  "end_ms": 327280,
  "text": "应该是远远小于2022年的"
 },
 {
  "id": 19106,
  "sequence_no": 103,
  "start_ms": 327280,
  "end_ms": 329480,
  "text": "不过和2022年相比"
 },
 {
  "id": 19107,
  "sequence_no": 104,
  "start_ms": 329480,
  "end_ms": 331160,
  "text": "有一个重大差别"
 },
 {
  "id": 19108,
  "sequence_no": 105,
  "start_ms": 331160,
  "end_ms": 333560,
  "text": "就是加息的起点不同"
 },
 {
  "id": 19109,
  "sequence_no": 106,
  "start_ms": 333560,
  "end_ms": 336760,
  "text": "2022年是从极低利率起步"
 },
 {
  "id": 19110,
  "sequence_no": 107,
  "start_ms": 336760,
  "end_ms": 339160,
  "text": "所以加息空间非常大"
 },
 {
  "id": 19111,
  "sequence_no": 108,
  "start_ms": 339160,
  "end_ms": 341360,
  "text": "經典是從3.5起步"
 },
 {
  "id": 19112,
  "sequence_no": 109,
  "start_ms": 341360,
  "end_ms": 343360,
  "text": "所以加息空間有限"
 },
 {
  "id": 19113,
  "sequence_no": 110,
  "start_ms": 343360,
  "end_ms": 346560,
  "text": "也就是預計本輪加息的子彈有限"
 },
 {
  "id": 19114,
  "sequence_no": 111,
  "start_ms": 346560,
  "end_ms": 349360,
  "text": "股市可能會盡快消化這一利空"
 },
 {
  "id": 19115,
  "sequence_no": 112,
  "start_ms": 349360,
  "end_ms": 351560,
  "text": "就是因為加息子彈有限"
 },
 {
  "id": 19116,
  "sequence_no": 113,
  "start_ms": 351560,
  "end_ms": 354360,
  "text": "沃爾什才需要更強硬的鷹派講話"
 },
 {
  "id": 19117,
  "sequence_no": 114,
  "start_ms": 354360,
  "end_ms": 356560,
  "text": "來放大加息的殺傷力"
 },
 {
  "id": 19118,
  "sequence_no": 115,
  "start_ms": 356560,
  "end_ms": 358760,
  "text": "他是一路講一路跌"
 },
 {
  "id": 19119,
  "sequence_no": 116,
  "start_ms": 358760,
  "end_ms": 361160,
  "text": "在記者會上繼續回答問題"
 },
 {
  "id": 19120,
  "sequence_no": 117,
  "start_ms": 361160,
  "end_ms": 362960,
  "text": "繼續打跌"
 },
 {
  "id": 19121,
  "sequence_no": 118,
  "start_ms": 362960,
  "end_ms": 365360,
  "text": "為什麼他要這麼鷹呢"
 },
 {
  "id": 19122,
  "sequence_no": 119,
  "start_ms": 365360,
  "end_ms": 367160,
  "text": "我認為恰恰是因為他手上"
 },
 {
  "id": 19123,
  "sequence_no": 120,
  "start_ms": 367160,
  "end_ms": 368960,
  "text": "只有三次加息的子彈"
 },
 {
  "id": 19124,
  "sequence_no": 121,
  "start_ms": 368960,
  "end_ms": 373240,
  "text": "如果打完后,通胀还下不来,就非常尴尬了"
 },
 {
  "id": 19125,
  "sequence_no": 122,
  "start_ms": 373240,
  "end_ms": 378680,
  "text": "在世界发生时,市场当然会直接感受到卧食鹰派讲话的寒气"
 },
 {
  "id": 19126,
  "sequence_no": 123,
  "start_ms": 378680,
  "end_ms": 381280,
  "text": "抛售股票,争取逃命机会"
 },
 {
  "id": 19127,
  "sequence_no": 124,
  "start_ms": 381280,
  "end_ms": 386680,
  "text": "但是情况还是这么个情况,今天的结果并非意料之外"
 },
 {
  "id": 19128,
  "sequence_no": 125,
  "start_ms": 386680,
  "end_ms": 391680,
  "text": "芝加哥的美联储观察工具早就对今年两次加息做出了预测"
 },
 {
  "id": 19129,
  "sequence_no": 126,
  "start_ms": 391680,
  "end_ms": 395200,
  "text": "在上半年就已经提示年内加息概率过半"
 },
 {
  "id": 19130,
  "sequence_no": 127,
  "start_ms": 395200,
  "end_ms": 399400,
  "text": "而且,預測工具也顯示了本輪加息幅度有限"
 },
 {
  "id": 19131,
  "sequence_no": 128,
  "start_ms": 399400,
  "end_ms": 403480,
  "text": "今天美聯儲的決議、點針圖和臥室的講話"
 },
 {
  "id": 19132,
  "sequence_no": 129,
  "start_ms": 403480,
  "end_ms": 406720,
  "text": "並非突然襲擊,而是早有預期"
 },
 {
  "id": 19133,
  "sequence_no": 130,
  "start_ms": 406720,
  "end_ms": 408840,
  "text": "股市可能會短期回調"
 },
 {
  "id": 19134,
  "sequence_no": 131,
  "start_ms": 408840,
  "end_ms": 412320,
  "text": "但是要像2022年那樣的轉為中期熊市"
 },
 {
  "id": 19135,
  "sequence_no": 132,
  "start_ms": 412320,
  "end_ms": 414240,
  "text": "則還不具備條件"
 },
 {
  "id": 19136,
  "sequence_no": 133,
  "start_ms": 414240,
  "end_ms": 418000,
  "text": "今天公布了一個零售數據,又稱恐怖數據"
 },
 {
  "id": 19137,
  "sequence_no": 134,
  "start_ms": 418000,
  "end_ms": 421720,
  "text": "美國零售銷售額在8月份增長了1.2%"
 },
 {
  "id": 19138,
  "sequence_no": 135,
  "start_ms": 421720,
  "end_ms": 424440,
  "text": "創5個月以來最大增長幅度"
 },
 {
  "id": 19139,
  "sequence_no": 136,
  "start_ms": 424440,
  "end_ms": 428440,
  "text": "即使汽油價格上漲,消費者仍然在增加支出"
 },
 {
  "id": 19140,
  "sequence_no": 137,
  "start_ms": 428440,
  "end_ms": 432440,
  "text": "低失業率和股市上漲等因素促進了消費"
 },
 {
  "id": 19141,
  "sequence_no": 138,
  "start_ms": 432440,
  "end_ms": 435940,
  "text": "但是這個零售數據沒有剔除通脹因素"
 },
 {
  "id": 19142,
  "sequence_no": 139,
  "start_ms": 435940,
  "end_ms": 438740,
  "text": "所以物價上漲會增加銷售額"
 },
 {
  "id": 19143,
  "sequence_no": 140,
  "start_ms": 438740,
  "end_ms": 442940,
  "text": "8月份加油債銷售額環比大幅增長3.1%"
 },
 {
  "id": 19144,
  "sequence_no": 141,
  "start_ms": 442940,
  "end_ms": 447640,
  "text": "零售數據的上漲有相當一部分是因為物價變貴拉高的"
 },
 {
  "id": 19145,
  "sequence_no": 142,
  "start_ms": 447640,
  "end_ms": 450140,
  "text": "並非經濟就有多繁榮了"
 },
 {
  "id": 19146,
  "sequence_no": 143,
  "start_ms": 450140,
  "end_ms": 454460,
  "text": "西西蘭超級年金主權基金判斷美股即將回調"
 },
 {
  "id": 19147,
  "sequence_no": 144,
  "start_ms": 454460,
  "end_ms": 456140,
  "text": "基金管理人表示"
 },
 {
  "id": 19148,
  "sequence_no": 145,
  "start_ms": 456140,
  "end_ms": 459140,
  "text": "當前美股漲勢已經出現明顯透支"
 },
 {
  "id": 19149,
  "sequence_no": 146,
  "start_ms": 459140,
  "end_ms": 462540,
  "text": "未來大概率要面臨一輪回調與降溫"
 },
 {
  "id": 19150,
  "sequence_no": 147,
  "start_ms": 462540,
  "end_ms": 465820,
  "text": "這支基金的規模是544億美元"
 },
 {
  "id": 19151,
  "sequence_no": 148,
  "start_ms": 465820,
  "end_ms": 468820,
  "text": "過去十年平均回報率9.68%"
 },
 {
  "id": 19152,
  "sequence_no": 149,
  "start_ms": 468820,
  "end_ms": 471380,
  "text": "基金表現與標股指數相當"
 },
 {
  "id": 19153,
  "sequence_no": 150,
  "start_ms": 471380,
  "end_ms": 474580,
  "text": "目前 據這支基金的經歷表示"
 },
 {
  "id": 19154,
  "sequence_no": 151,
  "start_ms": 474580,
  "end_ms": 477980,
  "text": "基金內部已經實際性縮減了風險敞口"
 },
 {
  "id": 19155,
  "sequence_no": 152,
  "start_ms": 477980,
  "end_ms": 479660,
  "text": "以防範下下波動"
 },
 {
  "id": 19156,
  "sequence_no": 153,
  "start_ms": 479660,
  "end_ms": 484760,
  "text": "股市高位,加息,AI巨頭聯合說要放緩技術迭代"
 },
 {
  "id": 19157,
  "sequence_no": 154,
  "start_ms": 484760,
  "end_ms": 487960,
  "text": "這些都是本周以來市場回調的主要原因"
 },
 {
  "id": 19158,
  "sequence_no": 155,
  "start_ms": 487960,
  "end_ms": 492860,
  "text": "但是,華人勳對AI降速和人類滅絕論表示不同意"
 },
 {
  "id": 19159,
  "sequence_no": 156,
  "start_ms": 492860,
  "end_ms": 497360,
  "text": "他不認為AI開發必須要在安全和速度上面二選一"
 },
 {
  "id": 19160,
  "sequence_no": 157,
  "start_ms": 497360,
  "end_ms": 499260,
  "text": "兩者完全可以兼得"
 },
 {
  "id": 19161,
  "sequence_no": 158,
  "start_ms": 499260,
  "end_ms": 503060,
  "text": "AI公司不需要去找美國政府來加強監管"
 },
 {
  "id": 19162,
  "sequence_no": 159,
  "start_ms": 503060,
  "end_ms": 506660,
  "text": "他們不如自己確認好產品安全之後再來發布"
 },
 {
  "id": 19163,
  "sequence_no": 160,
  "start_ms": 506660,
  "end_ms": 509560,
  "text": "他說,如果你開發一款產品或服務"
 },
 {
  "id": 19164,
  "sequence_no": 161,
  "start_ms": 509560,
  "end_ms": 513559,
  "text": "卻對它的功能、性能和安全沒有信心"
 },
 {
  "id": 19165,
  "sequence_no": 162,
  "start_ms": 513559,
  "end_ms": 515059,
  "text": "那就不要發布了"
 },
 {
  "id": 19166,
  "sequence_no": 163,
  "start_ms": 515059,
  "end_ms": 517260,
  "text": "加貝利基金的經理表示"
 },
 {
  "id": 19167,
  "sequence_no": 164,
  "start_ms": 517260,
  "end_ms": 520059,
  "text": "即使聲稱要放緩迭代的OpenAI"
 },
 {
  "id": 19168,
  "sequence_no": 165,
  "start_ms": 520059,
  "end_ms": 523760,
  "text": "Anthropic和XAI果真放緩了進度"
 },
 {
  "id": 19169,
  "sequence_no": 166,
  "start_ms": 523760,
  "end_ms": 526760,
  "text": "二三線AI實驗室也會迎頭趕殺"
 },
 {
  "id": 19170,
  "sequence_no": 167,
  "start_ms": 526760,
  "end_ms": 528060,
  "text": "補上缺口"
 },
 {
  "id": 19171,
  "sequence_no": 168,
  "start_ms": 528060,
  "end_ms": 532060,
  "text": "所以對人工智能算力的需求仍將保持高位"
 },
 {
  "id": 19172,
  "sequence_no": 169,
  "start_ms": 532060,
  "end_ms": 533760,
  "text": "這個基金經理認為"
 },
 {
  "id": 19173,
  "sequence_no": 170,
  "start_ms": 533760,
  "end_ms": 537060,
  "text": "半導體拋售正好是提供了買入的機會"
 },
 {
  "id": 19174,
  "sequence_no": 171,
  "start_ms": 537060,
  "end_ms": 541860,
  "text": "非常半導體指數在AI巨頭表態要放緩之後是跳空下跌"
 },
 {
  "id": 19175,
  "sequence_no": 172,
  "start_ms": 541860,
  "end_ms": 545160,
  "text": "到今天連續三個小音線也沒有緩過來"
 },
 {
  "id": 19176,
  "sequence_no": 173,
  "start_ms": 545160,
  "end_ms": 547160,
  "text": "不過可以期待反彈"
 },
 {
  "id": 19177,
  "sequence_no": 174,
  "start_ms": 547160,
  "end_ms": 549560,
  "text": "因為如果是根本性的利空"
 },
 {
  "id": 19178,
  "sequence_no": 175,
  "start_ms": 549560,
  "end_ms": 552960,
  "text": "應該是要連續暴跌而不是三個小音線"
 },
 {
  "id": 19179,
  "sequence_no": 176,
  "start_ms": 552960,
  "end_ms": 554160,
  "text": "跌幅不大"
 },
 {
  "id": 19180,
  "sequence_no": 177,
  "start_ms": 554160,
  "end_ms": 558960,
  "text": "說明行業指數對那幾家AI巨頭的所謂放緩並不恐慌"
 },
 {
  "id": 19181,
  "sequence_no": 178,
  "start_ms": 558960,
  "end_ms": 561860,
  "text": "實際上他們很快就會自我迭代"
 },
 {
  "id": 19182,
  "sequence_no": 179,
  "start_ms": 561860,
  "end_ms": 563460,
  "text": "推出新的模型"
 },
 {
  "id": 19183,
  "sequence_no": 180,
  "start_ms": 563460,
  "end_ms": 567460,
  "text": "通用人工智能AGI将会是他们追求的目标"
 },
 {
  "id": 19184,
  "sequence_no": 181,
  "start_ms": 567460,
  "end_ms": 571160,
  "text": "对半导体的需求也仍将保持强劲"
 },
 {
  "id": 19185,
  "sequence_no": 182,
  "start_ms": 571160,
  "end_ms": 575160,
  "text": "非半指数的鬼故事主要是来自于前期快速翻倍"
 },
 {
  "id": 19186,
  "sequence_no": 183,
  "start_ms": 575160,
  "end_ms": 577160,
  "text": "涨多了需要调整"
 },
 {
  "id": 19187,
  "sequence_no": 184,
  "start_ms": 577160,
  "end_ms": 580360,
  "text": "未来这个板块仍将继续产生牛骨"
 },
 {
  "id": 19188,
  "sequence_no": 185,
  "start_ms": 580360,
  "end_ms": 581960,
  "text": "半导体个股方面"
 },
 {
  "id": 19189,
  "sequence_no": 186,
  "start_ms": 581960,
  "end_ms": 585260,
  "text": "今天有消息称海力士与英特尔合作"
 },
 {
  "id": 19190,
  "sequence_no": 187,
  "start_ms": 585260,
  "end_ms": 587960,
  "text": "要在美国本土生产存储芯片"
 },
 {
  "id": 19191,
  "sequence_no": 188,
  "start_ms": 587960,
  "end_ms": 590960,
  "text": "合作的形式是租赁英特尔的产能"
 },
 {
  "id": 19192,
  "sequence_no": 189,
  "start_ms": 590960,
  "end_ms": 594060,
  "text": "或者与英特尔组建合资企业"
 },
 {
  "id": 19193,
  "sequence_no": 190,
  "start_ms": 594060,
  "end_ms": 596560,
  "text": "虽然目前还没有达成最终协议"
 },
 {
  "id": 19194,
  "sequence_no": 191,
  "start_ms": 596560,
  "end_ms": 598760,
  "text": "但这对英特尔显然是利好"
 },
 {
  "id": 19195,
  "sequence_no": 192,
  "start_ms": 598760,
  "end_ms": 601160,
  "text": "今天股价上涨了4%"
 },
 {
  "id": 19196,
  "sequence_no": 193,
  "start_ms": 601160,
  "end_ms": 604460,
  "text": "英特尔从高位下来调整得也比较充分"
 },
 {
  "id": 19197,
  "sequence_no": 194,
  "start_ms": 604460,
  "end_ms": 606760,
  "text": "应该有进一步反弹的机会"
 },
 {
  "id": 19198,
  "sequence_no": 195,
  "start_ms": 606760,
  "end_ms": 610460,
  "text": "还没有上市的OpenAI估值达到1.2万亿"
 },
 {
  "id": 19199,
  "sequence_no": 196,
  "start_ms": 610460,
  "end_ms": 612260,
  "text": "并且舍不得上市"
 },
 {
  "id": 19200,
  "sequence_no": 197,
  "start_ms": 612260,
  "end_ms": 614760,
  "text": "说要留到明年才IPO"
 },
 {
  "id": 19201,
  "sequence_no": 198,
  "start_ms": 614760,
  "end_ms": 618260,
  "text": "受益于GBT5.6等新模型的推出"
 },
 {
  "id": 19202,
  "sequence_no": 199,
  "start_ms": 618260,
  "end_ms": 622000,
  "text": "OpenAI年化營收已經突破400億美元"
 },
 {
  "id": 19203,
  "sequence_no": 200,
  "start_ms": 622000,
  "end_ms": 624100,
  "text": "大空頭Michael Burry指出"
 },
 {
  "id": 19204,
  "sequence_no": 201,
  "start_ms": 624100,
  "end_ms": 628060,
  "text": "OpenAI和幾家AI公司呼籲放緩AI開發"
 },
 {
  "id": 19205,
  "sequence_no": 202,
  "start_ms": 628060,
  "end_ms": 630520,
  "text": "說AI會毀滅人類之類的"
 },
 {
  "id": 19206,
  "sequence_no": 203,
  "start_ms": 630520,
  "end_ms": 632560,
  "text": "都是高級營銷手段"
 },
 {
  "id": 19207,
  "sequence_no": 204,
  "start_ms": 632560,
  "end_ms": 634900,
  "text": "純粹是為了壓制競爭對手"
 },
 {
  "id": 19208,
  "sequence_no": 205,
  "start_ms": 634900,
  "end_ms": 637800,
  "text": "為上市後更高的估值找藉口"
 },
 {
  "id": 19209,
  "sequence_no": 206,
  "start_ms": 637800,
  "end_ms": 640700,
  "text": "那一家OpenAI就能夠估值上萬億"
 },
 {
  "id": 19210,
  "sequence_no": 207,
  "start_ms": 640700,
  "end_ms": 643020,
  "text": "已經上市的科技巨頭高估值"
 },
 {
  "id": 19211,
  "sequence_no": 208,
  "start_ms": 643020,
  "end_ms": 645000,
  "text": "就看起來不那麼貴了"
 },
 {
  "id": 19212,
  "sequence_no": 209,
  "start_ms": 645000,
  "end_ms": 646220,
  "text": "比如谷歌"
 },
 {
  "id": 19213,
  "sequence_no": 210,
  "start_ms": 646220,
  "end_ms": 649000,
  "text": "多款产品具有强大互成和"
 },
 {
  "id": 19214,
  "sequence_no": 211,
  "start_ms": 649000,
  "end_ms": 652660,
  "text": "其中Gemini的估值应该不会输给OpenAI"
 },
 {
  "id": 19215,
  "sequence_no": 212,
  "start_ms": 652660,
  "end_ms": 655060,
  "text": "那么谷歌现在值四万亿"
 },
 {
  "id": 19216,
  "sequence_no": 213,
  "start_ms": 655060,
  "end_ms": 656720,
  "text": "似乎也不贵"
 },
 {
  "id": 19217,
  "sequence_no": 214,
  "start_ms": 656720,
  "end_ms": 659980,
  "text": "谷歌是我在公开账户盈利最多的个股"
 },
 {
  "id": 19218,
  "sequence_no": 215,
  "start_ms": 659980,
  "end_ms": 662540,
  "text": "我在市场质疑它会被AI替代"
 },
 {
  "id": 19219,
  "sequence_no": 216,
  "start_ms": 662540,
  "end_ms": 665980,
  "text": "反垄到诉讼缠身的时候就买入了"
 },
 {
  "id": 19220,
  "sequence_no": 217,
  "start_ms": 665980,
  "end_ms": 667700,
  "text": "现在市场不再质疑"
 },
 {
  "id": 19221,
  "sequence_no": 218,
  "start_ms": 667700,
  "end_ms": 670780,
  "text": "认为谷歌是唯一一个在AI全站技术上"
 },
 {
  "id": 19222,
  "sequence_no": 219,
  "start_ms": 670780,
  "end_ms": 673340,
  "text": "有一条龙布局的龙头企业了"
 },
 {
  "id": 19223,
  "sequence_no": 220,
  "start_ms": 673340,
  "end_ms": 675180,
  "text": "股价也不便宜了"
 },
 {
  "id": 19224,
  "sequence_no": 221,
  "start_ms": 675180,
  "end_ms": 677300,
  "text": "连巴菲特都追高了"
 },
 {
  "id": 19225,
  "sequence_no": 222,
  "start_ms": 677300,
  "end_ms": 680060,
  "text": "谷歌的日K线调整了三个多月"
 },
 {
  "id": 19226,
  "sequence_no": 223,
  "start_ms": 680060,
  "end_ms": 682780,
  "text": "最近有望逐渐走出反弹行情"
 },
 {
  "id": 19227,
  "sequence_no": 224,
  "start_ms": 682780,
  "end_ms": 685900,
  "text": "SPC-X今天涨了5.15%"
 },
 {
  "id": 19228,
  "sequence_no": 225,
  "start_ms": 685900,
  "end_ms": 687740,
  "text": "收盘150.88"
 },
 {
  "id": 19229,
  "sequence_no": 226,
  "start_ms": 687740,
  "end_ms": 689580,
  "text": "见底放量反弹后"
 },
 {
  "id": 19230,
  "sequence_no": 227,
  "start_ms": 689580,
  "end_ms": 692820,
  "text": "在130-150之间维持了横盘"
 },
 {
  "id": 19231,
  "sequence_no": 228,
  "start_ms": 692820,
  "end_ms": 695020,
  "text": "整理了有一段时间了"
 },
 {
  "id": 19232,
  "sequence_no": 229,
  "start_ms": 695020,
  "end_ms": 697260,
  "text": "今天上涨的消息面原因"
 },
 {
  "id": 19233,
  "sequence_no": 230,
  "start_ms": 697260,
  "end_ms": 699420,
  "text": "是公司计划下周22号"
 },
 {
  "id": 19234,
  "sequence_no": 231,
  "start_ms": 699420,
  "end_ms": 702580,
  "text": "进行星舰第14次测试飞行"
 },
 {
  "id": 19235,
  "sequence_no": 232,
  "start_ms": 702580,
  "end_ms": 706280,
  "text": "本次任務是興建首次挑戰環繞地球軌道"
 },
 {
  "id": 19236,
  "sequence_no": 233,
  "start_ms": 706280,
  "end_ms": 709060,
  "text": "繞地六圈後落入太平洋"
 },
 {
  "id": 19237,
  "sequence_no": 234,
  "start_ms": 709060,
  "end_ms": 713420,
  "text": "本次是非將順帶發射26顆Stalin V3衛星"
 },
 {
  "id": 19238,
  "sequence_no": 235,
  "start_ms": 713420,
  "end_ms": 716320,
  "text": "單次增加26T的網絡容量"
 },
 {
  "id": 19239,
  "sequence_no": 236,
  "start_ms": 716320,
  "end_ms": 719420,
  "text": "這是興建商業化提速的重大信號"
 },
 {
  "id": 19240,
  "sequence_no": 237,
  "start_ms": 719420,
  "end_ms": 721620,
  "text": "經過上市後的大起大落"
 },
 {
  "id": 19241,
  "sequence_no": 238,
  "start_ms": 721620,
  "end_ms": 724580,
  "text": "以及限售股票解禁壓力被接受"
 },
 {
  "id": 19242,
  "sequence_no": 239,
  "start_ms": 724580,
  "end_ms": 726860,
  "text": "股價也逐漸回歸平穩"
 },
 {
  "id": 19243,
  "sequence_no": 240,
  "start_ms": 726860,
  "end_ms": 730420,
  "text": "這家公司雖然現在不像其他巨頭那樣賺錢"
 },
 {
  "id": 19244,
  "sequence_no": 241,
  "start_ms": 730420,
  "end_ms": 732900,
  "text": "但被认为是极具技术实力"
 },
 {
  "id": 19245,
  "sequence_no": 242,
  "start_ms": 732900,
  "end_ms": 735020,
  "text": "与众不同的科技公司"
 },
 {
  "id": 19246,
  "sequence_no": 243,
  "start_ms": 735020,
  "end_ms": 736100,
  "text": "币权大跌"
 },
 {
  "id": 19247,
  "sequence_no": 244,
  "start_ms": 736100,
  "end_ms": 739100,
  "text": "因为清洗法案程序性表决失败"
 },
 {
  "id": 19248,
  "sequence_no": 245,
  "start_ms": 739100,
  "end_ms": 742660,
  "text": "今年不太可能有对稳定币利好的法案了"
 },
 {
  "id": 19249,
  "sequence_no": 246,
  "start_ms": 742660,
  "end_ms": 743980,
  "text": "数字消息影响"
 },
 {
  "id": 19250,
  "sequence_no": 247,
  "start_ms": 743980,
  "end_ms": 746660,
  "text": "Circle和Coinbase大跌的两天"
 },
 {
  "id": 19251,
  "sequence_no": 248,
  "start_ms": 746660,
  "end_ms": 748300,
  "text": "这个法案如果过了"
 },
 {
  "id": 19252,
  "sequence_no": 249,
  "start_ms": 748300,
  "end_ms": 749740,
  "text": "确实是利好"
 },
 {
  "id": 19253,
  "sequence_no": 250,
  "start_ms": 749740,
  "end_ms": 750820,
  "text": "如果没有过"
 },
 {
  "id": 19254,
  "sequence_no": 251,
  "start_ms": 750820,
  "end_ms": 753980,
  "text": "也不会减少这两家公司的收入"
 },
 {
  "id": 19255,
  "sequence_no": 252,
  "start_ms": 753980,
  "end_ms": 757380,
  "text": "我感觉CRCL情绪化十分严重"
 },
 {
  "id": 19256,
  "sequence_no": 253,
  "start_ms": 757380,
  "end_ms": 757940,
  "text": "涨跌"
 },
 {
  "id": 19257,
  "sequence_no": 254,
  "start_ms": 757940,
  "end_ms": 759000,
  "text": "喜怒无常"
 },
 {
  "id": 19258,
  "sequence_no": 255,
  "start_ms": 759000,
  "end_ms": 760740,
  "text": "很有币权的风格"
 },
 {
  "id": 19259,
  "sequence_no": 256,
  "start_ms": 760740,
  "end_ms": 764800,
  "text": "今天我ibk公开账户净值减少了521"
 },
 {
  "id": 19260,
  "sequence_no": 257,
  "start_ms": 764800,
  "end_ms": 767440,
  "text": "截图时的净值是194万"
 },
 {
  "id": 19261,
  "sequence_no": 258,
  "start_ms": 767440,
  "end_ms": 770040,
  "text": "我对未实现盈亏做了一个排序"
 },
 {
  "id": 19262,
  "sequence_no": 259,
  "start_ms": 770040,
  "end_ms": 771840,
  "text": "盈利多的是谷歌"
 },
 {
  "id": 19263,
  "sequence_no": 260,
  "start_ms": 771840,
  "end_ms": 772640,
  "text": "特斯拉"
 },
 {
  "id": 19264,
  "sequence_no": 261,
  "start_ms": 772640,
  "end_ms": 773500,
  "text": "英伟达"
 },
 {
  "id": 19265,
  "sequence_no": 262,
  "start_ms": 773500,
  "end_ms": 775840,
  "text": "微软都是科技巨头"
 },
 {
  "id": 19266,
  "sequence_no": 263,
  "start_ms": 775840,
  "end_ms": 777340,
  "text": "买入后不怕"
 },
 {
  "id": 19267,
  "sequence_no": 264,
  "start_ms": 777340,
  "end_ms": 779500,
  "text": "拿久了盈利就多了"
 },
 {
  "id": 19268,
  "sequence_no": 265,
  "start_ms": 779500,
  "end_ms": 781440,
  "text": "买科技巨头比较容易"
 },
 {
  "id": 19269,
  "sequence_no": 266,
  "start_ms": 781440,
  "end_ms": 783200,
  "text": "如果说这是道考题"
 },
 {
  "id": 19270,
  "sequence_no": 267,
  "start_ms": 783200,
  "end_ms": 786900,
  "text": "那这道考题说实在的算是送分题啊"
 },
 {
  "id": 19271,
  "sequence_no": 268,
  "start_ms": 786900,
  "end_ms": 789660,
  "text": "但是送分題也能丟分啊"
 },
 {
  "id": 19272,
  "sequence_no": 269,
  "start_ms": 789660,
  "end_ms": 791580,
  "text": "美光居然虧損第一"
 },
 {
  "id": 19273,
  "sequence_no": 270,
  "start_ms": 791580,
  "end_ms": 794060,
  "text": "才20股就給我虧了1300"
 },
 {
  "id": 19274,
  "sequence_no": 271,
  "start_ms": 794060,
  "end_ms": 796300,
  "text": "這真是太沒意思了"
 },
 {
  "id": 19275,
  "sequence_no": 272,
  "start_ms": 796300,
  "end_ms": 796620,
  "text": "好"
 },
 {
  "id": 19276,
  "sequence_no": 273,
  "start_ms": 796620,
  "end_ms": 798020,
  "text": "今天的節目就分享到這裡"
 },
 {
  "id": 19277,
  "sequence_no": 274,
  "start_ms": 798020,
  "end_ms": 798860,
  "text": "感謝大家收看"
 },
 {
  "id": 19278,
  "sequence_no": 275,
  "start_ms": 798860,
  "end_ms": 800180,
  "text": "我們下期節目再見"
 },
 {
  "id": 19279,
  "sequence_no": 276,
  "start_ms": 800180,
  "end_ms": 800620,
  "text": "拜拜"
 }
]