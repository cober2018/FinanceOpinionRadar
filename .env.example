# --- Database (docker compose 默认值) ---
DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5432/radar
# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# --- Object Storage (MinIO dev) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=radar
S3_SECRET_KEY=radar-secret
S3_BUCKET_MEDIA=radar-media
# --- LLM Provider (V1 默认可留空) ---
LLM_API_KEY=
LLM_BASE_URL=
# --- Media Discovery (EPIC-02，默认即开箱可用) ---
# YTDLP_BINARY=yt-dlp
# YTDLP_TIMEOUT_SEC=60
# MEDIA_HOST_ALLOWLIST=youtube.com,youtu.be,bilibili.com,douyin.com
# DISCOVER_PLAYLIST_MAX_ITEMS=50
# DISCOVER_DISPATCH_INTERVAL_SEC=300
# --- Media & ASR (EPIC-03，默认即开箱可用) ---
# FFMPEG_BINARY=ffmpeg
# FFMPEG_TIMEOUT_SEC=600
# YTDLP_DOWNLOAD_TIMEOUT_SEC=600
# SUBTITLE_LANG_PREFERENCE=zh-Hans,zh,en
# SUBTITLE_MIN_CHARS=10
# TRANSCRIPT_OVERLAP_TOLERANCE_MS=2000
# PREPARE_MAX_MEDIA_DURATION_SEC=14400
# PREPARE_SWEEP_INTERVAL_SEC=600
# PREPARE_SWEEP_BATCH_SIZE=200
# ASR_MODEL_NAME=medium             # 首次转录自动从 HuggingFace 下载（medium 约 1.4GB）
# ASR_DEVICE=cpu
# ASR_COMPUTE_TYPE=int8
# ASR_BEAM_SIZE=5
# ASR_MAX_SEGMENT_END_RATIO=1.05
# ENABLE_WHISPERX=false             # V1 默认关；开启需 pip install '.[whisperx]'
# ENABLE_DIARIZATION=false
# 模型下载慢/失败时（国内网络）取消注释：
# HF_ENDPOINT=https://hf-mirror.com
