# --- Database (docker compose 默认值) ---
DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5432/radar
# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# --- Object Storage (MinIO dev) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=radar
S3_SECRET_KEY=radar-secret
S3_BUCKET_MEDIA=radar-media
# --- LLM Provider（EPIC-04 观点抽取；留空 = Mock 模式，链路通但产出空观点） ---
LLM_API_KEY=
LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SEC=120
# LLM_MAX_RETRIES=2
# --- Media Discovery (EPIC-02，默认即开箱可用) ---
# YTDLP_BINARY=yt-dlp
# YTDLP_TIMEOUT_SEC=60
# YTDLP_COOKIES_FILE=           # 抖音需新鲜访客 cookie（Netscape 格式路径），YouTube/B 站可留空
# MEDIA_HOST_ALLOWLIST=youtube.com,youtu.be,bilibili.com,douyin.com
# DISCOVER_PLAYLIST_MAX_ITEMS=50
# DISCOVER_DISPATCH_INTERVAL_SEC=300
# --- Media & ASR (EPIC-03，默认即开箱可用) ---
# FFMPEG_BINARY=ffmpeg
# FFMPEG_TIMEOUT_SEC=600
# YTDLP_DOWNLOAD_TIMEOUT_SEC=600
# SUBTITLE_LANG_PREFERENCE=zh-Hans,zh,en
# SUBTITLE_MIN_CHARS=10
# TRANSCRIPT_OVERLAP_TOLERANCE_MS=2000
# PREPARE_MAX_MEDIA_DURATION_SEC=14400
# PREPARE_SWEEP_INTERVAL_SEC=600
# PREPARE_SWEEP_BATCH_SIZE=200
# ASR_PROVIDER=faster_whisper       # faster_whisper | mlx（Apple Silicon Metal，~57x 提速，见 README「ASR 引擎」）
# ASR_MLX_PYTHON=                   # mlx venv 的 python 路径（复用 voice-pro venv_arm64）
# ASR_MLX_WORKER=                   # mlx_worker.py 路径
# ASR_MODEL_NAME=medium             # 首次转录自动从 HuggingFace 下载（medium 约 1.4GB）
# ASR_DEVICE=cpu
# ASR_COMPUTE_TYPE=int8
# ASR_BEAM_SIZE=5
# ASR_MAX_SEGMENT_END_RATIO=1.05
# ENABLE_WHISPERX=false             # V1 默认关；开启需 pip install '.[whisperx]'
# ENABLE_DIARIZATION=false
# 模型下载慢/失败时（国内网络）取消注释：
# HF_ENDPOINT=https://hf-mirror.com
# --- Douyin（Plan #4，外部 dtk 解析服务；compose 栈见 infra/docker/docker-compose.douyin.yml） ---
# 空 = douyin 平台不可用（adapter 构造即报错，YouTube/B 站链路不受影响）
# 部署与引导序列：README「抖音 Quickstart」
# DOUYIN_API_BASE_URL=http://localhost:8080
# DOUYIN_API_KEY=                  # dtk 引导序列生成（scopes 必填，见 README）
# DOUYIN_API_TIMEOUT_SEC=60
# DOUYIN_CDN_ALLOWLIST=douyin.com,douyinvod.com   # 无水印直链落盘 CDN 白名单
# DOUYIN_DISCOVER_MAX_PAGES=3      # 单轮 discover 翻页上限（20 条/页）
# --- Live ingest（直播分片入库；依赖 StreamCap 分片落盘，见 compose 栈） ---
# LIVE_SEGMENTS_DIR=data/douyin/live_segments    # 空 = live ingest 不启用（beat 每轮单行 no-op 日志）
# LIVE_SCAN_INTERVAL_SEC=300       # beat：分片扫描
# LIVE_CLOSE_GRACE_SEC=900         # 分片静默 ≥ 此值 → 会话视为下播收尾
# LIVE_MIN_SEGMENT_SEC=30          # 小于视为残片跳过（不计入转写偏移）
# LIVE_MAX_SEGMENTS_PER_SESSION=120
# LIVE_SEGMENT_MAX_ATTEMPTS=3      # 同分片连续失败 N 次后跳过记账
# --- Recorder bridge（直播账号 → StreamCap 值守同步） ---
# RECORDER_CONFIG_PATH=data/douyin/streamcap-config/recordings.json   # 空 = 值守桥不启用
# RECORDER_CONTAINER_NAME=streamcap              # 配置变更后 docker restart 的目标容器
# RECORDER_SYNC_INTERVAL_SEC=600   # beat：账号 → 录制器配置同步
