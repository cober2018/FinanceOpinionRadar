<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  开机自启（Plan #7）：登录时跑一次 scripts/dev_up.sh up，幂等拉齐
  docker 依赖(PG/Redis/MinIO) + dtk 容器组 + API :8010 + worker-beat。
  由 apps/api 的 /settings/runtime 开关安装/卸载（__REPO_DIR__ 渲染为仓库路径）。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.financeopinionradar.autostart</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_DIR__/scripts/dev_up.sh</string>
    <string>up</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__REPO_DIR__/logs/autostart.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_DIR__/logs/autostart.log</string>
</dict>
</plist>
